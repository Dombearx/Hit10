  "gen_grandpa": "Grandpa with a Pocket Watch",
  "gen_grandpa_desc": "Grandpa: “My father's watch. Runs like a dream.”\nGrandma: “Dreams don't run on time.”",
  "gen_grandma": "Grandma with an Egg Timer",
  "gen_grandma_desc": "Grandma: “Egg timer from seventy-four. Never late once.”\nGrandpa: “It never has to go anywhere.”",
  "gen_cuckoo": "Cuckoo",
  "gen_cuckoo_desc": "Grandpa: “Cuckoos every five seconds exactly.”\nGrandma: “It did. Before you fixed it.”",
  "gen_metronome": "Metronome",
  "gen_metronome_desc": "Grandpa: “I learned to dance with this.”\nGrandma: “You didn't, though.”",
  "gen_watchmaker": "Watchmaker",
  "gen_watchmaker_desc": "Grandpa: “Mr Henry. He can fix any watch.”\nGrandma: “He hands yours back without a word.”",
  "gen_sprintJudge": "Sprint Judge",
  "gen_sprintJudge_desc": "Grandpa: “Knows what a hundredth of a second is.”\nGrandma: “Do you know what five p.m. is?”",
  "gen_stationClock": "Station Clock",
  "gen_stationClock_desc": "Grandpa: “Always late, but it always gets there.”\nGrandma: “So do you. That's why you like it.”",
  "gen_quartz": "Quartz Clock",
  "gen_quartz_desc": "Grandpa: “32,768 vibrations a second.”\nGrandma: “And you don't budge until I call you for dinner.”",
  "gen_atomic": "Atomic Clock",
  "gen_atomic_desc": "Grandpa: “Off by a second every hundred million years. Now I'll make it.”\nGrandma: “You said that about the cuckoo.”",
  "gen_gps": "GPS Satellite",
  "gen_gps_desc": "Grandpa: “Knows where I am to the metre.”\nGrandma: “So do I. The garage.”",
  "gen_pulsar": "Pulsar",
  "gen_pulsar_desc": "Grandpa: “A star that ticks. Borrowed from space.”\nGrandma: “You'll return it like my drill.”",
  "gen_timeMachine": "Time Machine",
  "gen_timeMachine_desc": "Grandpa: “If only I'd had this in seventy-four… But I made it anyway!”\nGrandma: “Mm-hm.”",
  "gen_schrodinger": "Schrödinger's Cat",
  "gen_schrodinger_desc": "Grandpa: “Hit and missed at the same time.”\nGrandma: “Like you with anniversary flowers.”",
  "gen_chronos": "Chronos",
  "gen_chronos_desc": "Grandpa: “Time itself. The most accurate clock in the world.”\nGrandma: “You don't buy time. You invite it.”",
